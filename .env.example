# Absolute address of THIS site, no trailing slash (used for metadata and the sitemap).
# Baked in at build time: set it before you deploy, and redeploy after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe keys (test mode: sk_test_ / pk_test_). The publishable key is REQUIRED: it powers the card form
# that is embedded in the site. Also baked in at build time.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret. The endpoint /api/webhooks/stripe needs ONE event: payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- WooCommerce payment bridge (optional) ----------------------------------
# Lets a WooCommerce store take card payments through this site's Stripe account. The customer pays on a
# page ON THIS SITE. Both are server-only. The secret must match the one saved in the WordPress plugin.
# Generate one with:  openssl rand -hex 32   (32+ characters)
# WOO_BRIDGE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The WordPress site, https only (http://localhost is allowed in development). No trailing slash.
# WOO_SITE_URL=https://shop.example.com

# --- Optional ---------------------------------------------------------------
# Inbox that the /contact form opens a mailto: to.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@lashglobar.com
# Set to "false" to turn Lenis smooth scrolling off site-wide.
# NEXT_PUBLIC_SMOOTH_SCROLL=true
